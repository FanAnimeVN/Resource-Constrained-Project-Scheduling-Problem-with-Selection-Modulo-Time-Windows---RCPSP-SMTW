{
  "name": "curriculum-planner-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "gen:api": "cd ../backend && .venv/bin/cplan export-openapi --out ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.4",
    "@tanstack/react-query": "5.62.0",
    "@xyflow/react": "12.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.15.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.0.14",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.4.4",
    "tailwindcss": "4.0.14",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
